#! /bin/bash

echo -n '=> Apply updates from APT...' && \
sudo apt update && \
sudo apt -y upgrade && \
sudo apt autoremove && \
echo -m '=> Check Composer, Snap, and Flatpak...' && \
sudo composer self-update && \
sudo snap refresh && \
sudo flatpak update -y && \
echo -n '=> Check for firmware updates...' && \
sudo fwupdmgr refresh --force && \
sudo fwupdmgr get-updates && \
sudo fwupdmgr update && \
echo -n '=> Updating database... ' && \
sudo updatedb 2> /dev/null && \
echo 'done.'

